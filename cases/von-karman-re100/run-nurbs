
gcc   -shared -o libvkvs.so -fPIC von-karman.c

exe=../../build/rbvms/rbvms
mesh=von-karman-nurbs.mesh 


rm output* log-nurbs

mpirun -n 8 $exe -m $mesh -o 2  -r 4 \
--dyn-visc 1e-2  --density 1.0 \
--strong-bdr "1 2" --outflow-bdr 4  --weak-bdr 3 -l libvkvs.so \
-s 45 -dt 0.1 --dt_vis 0.5 -tf 1000 \
-lt 1e-3 -ni 20  -ri 10  | tee log-nurbs
